# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://tideron-app.vercel.app
NEXTAUTH_SECRET=generer-med-openssl-rand-base64-32

# ── E-post (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Kart (valgfritt, for Mapbox-fliser) ──────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ── Kunnskapsassistent (chatbot) ──────────────────────────────────────────────
# Hentes fra console.anthropic.com - brukes til å generere svar.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Valgfritt, default: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
# Hentes fra dashboard.voyageai.com - brukes til embeddings (søk i kunnskapsbasen).
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Valgfritt, default: voyage-3.5
VOYAGE_MODEL=voyage-3.5
